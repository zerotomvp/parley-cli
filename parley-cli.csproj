<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ParleyCli</RootNamespace>

    <!-- .NET Tool Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>parley</ToolCommandName>
    <PackageId>parley-cli</PackageId>
    <Authors>Georgios Diamantopoulos</Authors>
    <Description>A two-party message channel so a Claude Code and a Codex session can coordinate over a shared transcript</Description>
  </PropertyGroup>

  <!-- Version from git commit - must run before GenerateNuspec -->
  <Target Name="SetVersionFromGit" BeforeTargets="GenerateNuspec;GetPackageVersion;GetAssemblyVersion">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommit" />
    </Exec>
    <Exec Command="git status --porcelain -- ." ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitDirty" />
    </Exec>
    <PropertyGroup Condition="'$(GitDirty)' == ''">
      <Version>1.0.0-v$(GitCommit)</Version>
      <PackageVersion>1.0.0-v$(GitCommit)</PackageVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(GitDirty)' != ''">
      <Version>1.0.0-v$(GitCommit)-dirty</Version>
      <PackageVersion>1.0.0-v$(GitCommit)-dirty</PackageVersion>
    </PropertyGroup>
  </Target>

  <PropertyGroup>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.2" />
  </ItemGroup>

</Project>
