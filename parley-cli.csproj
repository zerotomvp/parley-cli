<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ParleyCli</RootNamespace>

    <!-- .NET Tool Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>parley</ToolCommandName>
    <PackageId>parley-cli</PackageId>
    <Authors>Georgios Diamantopoulos</Authors>
    <Description>A durable, role-addressed message channel for coordinating independent agent sessions</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/zerotomvp/parley-cli</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zerotomvp/parley-cli.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>agents;cli;codex;claude;pi;coordination</PackageTags>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>dev.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <!-- MinVer supplies the latest reachable v-prefixed SemVer tag. Only tracked source
       modifications mark a build dirty, so local handover files do not taint releases. -->
  <Target Name="MarkDirtyVersion" AfterTargets="MinVer">
    <Exec Command="git diff-index --quiet HEAD -- ." IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="GitDirtyExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(GitDirtyExitCode)' == '1' and '$(MinVerPreRelease)' == ''">
      <Version>$(Version)-dirty</Version>
      <PackageVersion>$(PackageVersion)-dirty</PackageVersion>
      <InformationalVersion>$(InformationalVersion)-dirty</InformationalVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(GitDirtyExitCode)' == '1' and '$(MinVerPreRelease)' != ''">
      <Version>$(Version).dirty</Version>
      <PackageVersion>$(PackageVersion).dirty</PackageVersion>
      <InformationalVersion>$(InformationalVersion).dirty</InformationalVersion>
    </PropertyGroup>
  </Target>

  <PropertyGroup>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="CHANGELOG.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <EmbeddedResource Remove="tests/**/*" />
    <None Remove="tests/**/*" />
  </ItemGroup>

</Project>
